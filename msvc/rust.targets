<?xml version="1.0" encoding="utf-8"?>
<!-- See rust.props. Imported at the end of a project, after its own property groups. -->
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <!-- The default build always lands in $(Configuration)-$(Platform), whichever components default to rust.
       A variant build names its own directories with /p:CppRustOutSuffix=-rust so it never overwrites the product. -->
  <PropertyGroup Condition="'$(CppRustOutSuffix)'!=''">
    <OutDir>$(OutDir.TrimEnd('\'))$(CppRustOutSuffix)\</OutDir>
    <IntDir>$(IntDir.TrimEnd('\'))$(CppRustOutSuffix)\</IntDir>
  </PropertyGroup>

  <!-- src/zstream.cpp is compiled as its own file in both builds, zstream.hpp must not include it. -->
  <ItemDefinitionGroup>
    <ClCompile>
      <PreprocessorDefinitions>ZSTREAM_FACADE=1;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
  </ItemDefinitionGroup>

  <!-- Zthread switch: the facade in src/ugrep.cpp calls the Rust bridge only when this is defined. -->
  <ItemDefinitionGroup Condition="'$(CPP_RUST_IMPL_ZTHREAD)'=='rust'">
    <ClCompile>
      <PreprocessorDefinitions>CPP_RUST_IMPL_ZTHREAD_RUST=1;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
  </ItemDefinitionGroup>

  <!-- Cleanup: the legacy C++ bodies of the ported units are deleted, so the umbrella is always linked. -->
  <ItemDefinitionGroup Condition="'$(RustLinkUmbrella)'=='true'">
    <ClCompile>
      <AdditionalIncludeDirectories>$(RustTargetDir)\cxxbridge;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
    </ClCompile>
    <Link>
      <GenerateMapFile>true</GenerateMapFile>
      <MapFileName>$(OutDir)$(TargetName).map</MapFileName>
      <AdditionalDependencies>$(RustUmbrellaLib);ntdll.lib;userenv.lib;bcrypt.lib;ws2_32.lib;advapi32.lib;kernel32.lib;%(AdditionalDependencies)</AdditionalDependencies>
    </Link>
  </ItemDefinitionGroup>

  <PropertyGroup>
    <!-- Configurations that define HAVE_LIB* (not Base-*) link the codec libraries through project references: the Rust zstream
         may call them (feature codecs). Base-* configurations link none, and the Rust zstream is built without codec calls. -->
    <RustCargoFeatures Condition="!$(Configuration.StartsWith('Base-'))">codecs</RustCargoFeatures>
    <RustCargoFeatureArg Condition="'$(RustCargoFeatures.Trim())'!=''">--features &quot;$(RustCargoFeatures.Trim())&quot;</RustCargoFeatureArg>
    <!-- ugrep.vcxproj references the brotli and bzip3 projects and defines HAVE_LIBBROTLI/HAVE_LIBBZIP3 in the same configurations,
         so the Rust zstream may call them there (D-S6-1); the Base-* configurations and ugrep-indexer link none of them. -->
    <RustCodecLibsEnv Condition="'$(MSBuildProjectName)'=='ugrep' And !$(Configuration.StartsWith('Base-'))">;CPP2RUST_CODEC_LIBS=zlib,bz2,lzma,lz4,zstd,viiz,brotlidec,brotlicommon,bzip3</RustCodecLibsEnv>
  </PropertyGroup>

  <!-- /MT in the Base configurations: the Rust side must use the static CRT too. -->
  <!-- Before ClCompile: the facade includes the header cargo generates for the cxx bridge. -->
  <Target Name="CargoBuildUmbrella" BeforeTargets="ClCompile" Condition="'$(RustLinkUmbrella)'=='true'">
    <Exec Command="cargo build --release --locked -p rust_umbrella $(RustCargoFeatureArg) --manifest-path &quot;$(RustRoot)Cargo.toml&quot; --target-dir &quot;$(RustTargetDir)&quot;"
          EnvironmentVariables="RUSTFLAGS=-C target-feature=+crt-static;CPP2RUST_CODECS_FROM_LINKER=1$(RustCodecLibsEnv)" />
  </Target>
</Project>
