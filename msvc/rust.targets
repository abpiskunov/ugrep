<?xml version="1.0" encoding="utf-8"?>
<!-- See rust.props. Imported at the end of a project, after its own property groups. -->
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <!-- The Rust variant builds into its own directories so it never overwrites the C++ baseline. -->
  <PropertyGroup Condition="'$(RustLinkUmbrella)'=='true'">
    <OutDir>$(OutDir.TrimEnd('\'))-rust\</OutDir>
    <IntDir>$(IntDir.TrimEnd('\'))-rust\</IntDir>
  </PropertyGroup>

  <!-- src/zstream.cpp is compiled as its own file in both builds, zstream.hpp must not include it. -->
  <ItemDefinitionGroup>
    <ClCompile>
      <PreprocessorDefinitions>ZSTREAM_FACADE=1;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
  </ItemDefinitionGroup>

  <ItemDefinitionGroup Condition="'$(RustLinkUmbrella)'=='true'">
    <ClCompile>
      <PreprocessorDefinitions Condition="'$(CPP_RUST_IMPL_SRC_LEAVES)'=='rust'">CPP_RUST_IMPL_SRC_LEAVES=1;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <PreprocessorDefinitions Condition="'$(CPP_RUST_IMPL_SRC_LEAVES)'=='rust'">CPP_RUST_IMPL_ZOPEN=1;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <PreprocessorDefinitions Condition="'$(CPP_RUST_IMPL_SRC_LEAVES)'=='rust'">CPP_RUST_IMPL_ZSTREAM=1;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <PreprocessorDefinitions Condition="'$(CPP_RUST_IMPL_SRC_CORE)'=='rust'">CPP_RUST_IMPL_SRC_CORE=1;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <PreprocessorDefinitions Condition="'$(CPP_RUST_IMPL_SRC_TUI)'=='rust'">CPP_RUST_IMPL_SRC_TUI=1;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <PreprocessorDefinitions Condition="'$(CPP_RUST_IMPL_SRC_INDEXER)'=='rust'">CPP_RUST_IMPL_SRC_INDEXER=1;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
    <ClCompile>
      <AdditionalIncludeDirectories>$(RustTargetDir)\cxxbridge;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
    </ClCompile>
    <Link>
      <GenerateMapFile>true</GenerateMapFile>
      <MapFileName>$(OutDir)$(TargetName).map</MapFileName>
      <AdditionalDependencies>$(RustUmbrellaLib);ntdll.lib;userenv.lib;bcrypt.lib;ws2_32.lib;advapi32.lib;kernel32.lib;%(AdditionalDependencies)</AdditionalDependencies>
    </Link>
  </ItemDefinitionGroup>

  <ItemDefinitionGroup Condition="'$(CppRustTap)'=='true'">
    <ClCompile>
      <PreprocessorDefinitions>CPP2RUST_TAP=1;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <LanguageStandard>stdcpp17</LanguageStandard>
    </ClCompile>
  </ItemDefinitionGroup>

  <PropertyGroup>
    <RustCargoFeatures Condition="'$(CppRustTap)'=='true'">tap</RustCargoFeatures>
    <!-- Configurations that define HAVE_LIB* (not Base-*) link the codec libraries through project references: the Rust zstream
         may call them (feature codecs). Base-* configurations link none, and the Rust zstream is built without codec calls. -->
    <RustCargoFeatures Condition="!$(Configuration.StartsWith('Base-'))">$(RustCargoFeatures) codecs</RustCargoFeatures>
    <RustCargoFeatureArg Condition="'$(RustCargoFeatures.Trim())'!=''">--features &quot;$(RustCargoFeatures.Trim())&quot;</RustCargoFeatureArg>
  </PropertyGroup>

  <!-- /MT in the Base configurations: the Rust side must use the static CRT too. -->
  <!-- Before ClCompile: the facade includes the header cargo generates for the cxx bridge. -->
  <Target Name="CargoBuildUmbrella" BeforeTargets="ClCompile" Condition="'$(RustLinkUmbrella)'=='true'">
    <Exec Command="cargo build --release --locked -p rust_umbrella $(RustCargoFeatureArg) --manifest-path &quot;$(RustRoot)Cargo.toml&quot; --target-dir &quot;$(RustTargetDir)&quot;"
          EnvironmentVariables="RUSTFLAGS=-C target-feature=+crt-static;CPP2RUST_CODECS_FROM_LINKER=1" />
  </Target>
</Project>
